# Copy to .env. The app runs fully in deterministic demo / simulation mode
# WITHOUT any of these set. They only enable optional, non-core integrations.

# Server
PORT=4000
DATABASE_PATH=data/app.db

# Optional: OpenRouter for human-readable summary text. When absent, the app
# uses deterministic fallback text. The core financial/risk/decision logic
# never depends on an LLM.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Razorpay. The adapter runs in simulation mode by default; no live
# account is required. Set RAZORPAY_MODE=live and provide the secret to verify
# real webhook signatures (HMAC-SHA256 of the raw body, X-Razorpay-Signature).
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
