# Copy to .env: `cp .env.example .env`
#
# The app runs FULLY in a deterministic demo / simulation mode WITHOUT any of
# these credentials set. They only enable optional, non-core integrations. The
# core financial / risk / decision logic never depends on an LLM or a live
# payment gateway.

# --- Server ---------------------------------------------------------------
PORT=4000
DATABASE_PATH=data/app.db

# --- OpenRouter (optional) ------------------------------------------------
# Enables human-readable explanation / recovery-message text. When absent, the
# app uses deterministic fallback text built from the decision evidence.
# Put your key here (in the repo-root .env). Leave as-is to stay in demo mode.
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Razorpay (optional) --------------------------------------------------
# The adapter runs in simulation mode by default; no live account is required.
# Set RAZORPAY_MODE=live and provide RAZORPAY_WEBHOOK_SECRET to verify real
# webhook signatures (HMAC-SHA256 of the raw body, X-Razorpay-Signature header).
RAZORPAY_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
