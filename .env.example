# Copy to .env. The app runs fully in deterministic demo mode WITHOUT any of
# these set. They only enable optional, non-core integrations.

# Optional: OpenRouter for human-readable summary text. When absent, the app
# uses deterministic fallback text. The core financial/risk/decision logic
# never depends on an LLM.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Razorpay webhook signature verification. The Razorpay adapter runs
# in simulation/test mode by default; no live account is required.
RAZORPAY_WEBHOOK_SECRET=
