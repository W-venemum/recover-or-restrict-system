{
  "name": "@ror/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Recover-or-Restrict decision engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types --import ./src/register-ts.mjs src/api/server.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --experimental-strip-types --import ./src/register-ts.mjs src/db/migrate.ts",
    "seed": "node --experimental-strip-types --import ./src/register-ts.mjs src/seed/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
